--!nocheck
-- MillionaireDad_Review: reproducible Studio assembly of the review model (static pose, Case prop in the RIGHT hand, one grip).
-- GENERATED by scripts/gen_assembly.py from data/rig_manifest.json.
-- Run in the Studio command bar of a CLEAN place (Rojo disconnected) after importing the two FBX files with the 3D Importer
-- (Scale Unit Stud, factor 1, World Forward Front / Up Top):
--   export/MillionaireDad_Body.fbx   -> model "MillionaireDad_Body"
--   export/MillionaireDad_Props.fbx  -> model "MillionaireDad_Props"
-- Result: Workspace.MillionaireDad_Review with Case (CaseGrip: WeldConstraint RightHand -> Case). No PoseController / pose folders: the model is static.
-- Blender (x,y,z) = (X,-F,H) -> Roblox model position (-x, z, y).
local ws = workspace
local m = ws:FindFirstChild("MillionaireDad_Body")
local wrap = ws:FindFirstChild("MillionaireDad_Props")
assert(m and wrap, "import both FBX files first")

local function R(x, y, z)
	return Vector3.new(-x, z, y)
end

-- 1. placement: shift the imported body so that UpperTorso sits on the exact mapped bbox centre of the Blender mesh
local delta = m.UpperTorso.Position - R(0.000000, -0.084444, 3.675000)
m:TranslateBy(-delta)
print("MD placement delta", delta, "check Head", (m.Head.Position - R(-0.045931, -0.058468, 5.347861)).Magnitude)

-- 2. prop: one MeshPart, ONE WeldConstraint (RightHand -> Case)
local p = nil
for _, d in ipairs(wrap:GetDescendants()) do
	if d:IsA("MeshPart") and string.find(d.Name, "Case", 1, true) == 1 then
		p = d
	end
end
assert(p, "prop mesh missing: Case")
p.Name = "Case"
p.Parent = ws
p.CFrame = CFrame.new(R(-2.457300, -0.190500, 1.146875))
p.Parent = m
p.Anchored = false
p.CanCollide = false
p.CanQuery = false
p.CanTouch = false
p.Massless = true
local w = Instance.new("WeldConstraint")
w.Name = "CaseGrip"
w.Part0, w.Part1 = m.RightHand, p
w.Parent = p
wrap:Destroy()
for _, d in ipairs(m:GetDescendants()) do
	if d:IsA("BasePart") then
		d.Anchored = false
	end
	if d:IsA("MeshPart") then
		d.Color = Color3.new(1, 1, 1) -- the atlas already carries the colours: a white tint avoids a double multiplication
	end
end
m.Name = "MillionaireDad_Review"
print("MillionaireDad_Review assembled")
