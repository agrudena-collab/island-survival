local model = workspace:FindFirstChild("LakesideCabinHouse", true)
assert(model, "LakesideCabinHouse not found in Workspace -- import the FBX first")

local painted, noncollided, missed = 0, 0, {}
for _, inst in ipairs(model:GetDescendants()) do
	if inst:IsA("BasePart") then
		local entry = PALETTE[PARTS[inst.Name] or ""]
		if entry then
			inst.Color = entry.color
			inst.Material = entry.material
			inst.Transparency = entry.transparency
			if ANCHOR then inst.Anchored = true end
			if NONCOLLIDE[inst.Name] then
				inst.CanCollide = false
				noncollided += 1
			end
			painted += 1
		else
			table.insert(missed, inst.Name)
		end
	end
end

print(string.format("LakesideCabinHouse: painted %d parts (%d set non-colliding), %d unmatched", painted, noncollided, #missed))
if #missed > 0 then
	warn("unmatched parts: " .. table.concat(missed, ", "))
end
