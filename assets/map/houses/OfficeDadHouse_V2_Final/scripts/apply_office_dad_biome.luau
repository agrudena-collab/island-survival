local S = 1.275

local root = workspace:FindFirstChild("OfficeDadBiome_V2")
if not root then
	root = Instance.new("Model")
	root.Name = "OfficeDadBiome_V2"
	root.Parent = workspace
end
local old = root:FindFirstChild("Collision")
if old then
	old:Destroy()
end
local col = Instance.new("Folder")
col.Name = "Collision"
col.Parent = root
local function solid(name, cf, size)
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.CanTouch, p.Transparency = name, true, true, false, 1
	p.Size, p.CFrame, p.Parent = size, cf, col
	return p
end
for i, b in ipairs(DATA.box) do
	solid("B" .. i, CFrame.new((b[1] + b[2]) / 2, (b[3] + b[4]) / 2, (b[5] + b[6]) / 2), Vector3.new(b[2] - b[1], b[4] - b[3], b[6] - b[5]))
end
for i, y in ipairs(DATA.yard) do
	if y[1] == "box" then
		solid("Y" .. i, CFrame.new(y[2], y[6] / 2, y[3]), Vector3.new(y[4], y[6], y[5]))
	elseif y[1] == "cyl" then
		local p = solid("Y" .. i, CFrame.new(y[2], y[5] / 2, y[3]) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(y[5], y[4] * 2, y[4] * 2))
		p.Shape = Enum.PartType.Cylinder
	elseif y[1] == "fence" then
		local a, b2 = Vector3.new(y[2], 0, y[3]), Vector3.new(y[4], 0, y[5])
		if (b2 - a).Magnitude > 0.1 then
			solid("Y" .. i, CFrame.lookAt((a + b2) / 2 + Vector3.new(0, 1.7 * S, 0), b2 + Vector3.new(0, 1.7 * S, 0)), Vector3.new(0.6 * S, 3.4 * S, (b2 - a).Magnitude))
		end
	end
end
-- biome meshes are visual only: their convex hulls bridged gaps and made invisible ramps; collision comes from the Collision boxes above
-- (full detail at any distance: no grass popping)
for _, p in ipairs(root:GetDescendants()) do
	if p:IsA("MeshPart") then
		p.Anchored, p.CanTouch, p.CanCollide = true, false, false
		p.CollisionFidelity = Enum.CollisionFidelity.Box
		p.RenderFidelity = Enum.RenderFidelity.Precise
		if string.sub(p.Name, 1, 2) == "G_" then
			p.Transparency = 0.7
		elseif string.sub(p.Name, 1, 2) == "N_" then
			p.Material = Enum.Material.Neon
		end
	end
end
print("OfficeDadBiome_V2 collision built")
