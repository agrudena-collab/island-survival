local model = workspace:FindFirstChild("GrillDadHouse", true)
assert(model, "GrillDadHouse not found in Workspace -- import the FBX first")

local painted, noncollided, missed = 0, 0, {}
for _, inst in ipairs(model:GetDescendants()) do
	if inst:IsA("BasePart") then
		local entry = PALETTE[PARTS[inst.Name] or ""]
		if entry then
			inst.Color = entry.color
			inst.Material = entry.material
			inst.Transparency = entry.transparency
			inst.Anchored = true
			if NONCOLLIDE[inst.Name] then
				inst.CanCollide = false
				noncollided += 1
			end
			painted += 1
		else
			table.insert(missed, inst.Name)
		end
	end
end

print(string.format("GrillDadHouse: painted %d parts (%d set non-colliding), %d unmatched", painted, noncollided, #missed))
if #missed > 0 then
	warn("unmatched parts: " .. table.concat(missed, ", "))
end
