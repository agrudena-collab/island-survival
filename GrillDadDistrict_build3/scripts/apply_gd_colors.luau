local ROOF = { HouseRoof = true, NeighborRoofs = true, ParkRoof = true }
local n, miss = 0, 0
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("MeshPart") then
		local group, mat = string.match(d.Name, "^([^_]+)_([^_]+)_")
		local p = mat and PALETTE[mat]
		if p then
			local m = p.material
			if ROOF[group] and string.sub(mat, 1, 4) == "Roof" then m = Enum.Material.RoofShingles end
			d.Color, d.Material, d.Transparency = p.color, m, p.transparency
			d.Anchored = true
			d.CanCollide = false -- real collision comes from Colliders (build_studio_colliders_anchors.luau); camera_block.luau then makes buildings solid for the camera
			d.CastShadow = p.transparency < 0.2 and p.material ~= Enum.Material.Neon
			n += 1
		else miss += 1 end
	end
end
print(("painted %d parts, %d unmatched"):format(n, miss))