local ROOF = { Roof = true, HouseRoof = true, TowerRoof = true }
local ROOF_EXCLUDE = { Brick = true, Iron = true, Stone = true, StoneDark = true, Lamp = true, Glass = true, Red = true, Cream = true, White = true }
local NONCOLLIDE = { Roof = true, HouseRoof = true, Glass = true, Water = true, Trees = false }
local n, miss = 0, 0
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("MeshPart") then
		local group, mat = string.match(d.Name, "^([^_]+)_([^_]+)_")
		local p = mat and PALETTE[mat]
		if p then
			local m = MATMAP[mat] or p.material
			if ROOF[group] and not ROOF_EXCLUDE[mat] then m = Enum.Material.RoofShingles end
			d.Color, d.Material, d.Transparency = p.color, m, p.transparency
			d.Anchored = true
			d.CanCollide = false -- real collision comes from Colliders (data/colliders.json); meshes are visual only
			n += 1
		else miss += 1 end
	end
end
print(("painted %d parts, %d unmatched"):format(n, miss))